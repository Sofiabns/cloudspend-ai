{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCostExplorer",
      "Effect": "Allow",
      "Action": ["ce:GetCostAndUsage", "ce:GetCostForecast", "ce:GetAnomalies", "ce:GetAnomalyMonitors"],
      "Resource": "*"
    },
    {
      "Sid": "ReadCostOptimizationHub",
      "Effect": "Allow",
      "Action": ["cost-optimization-hub:GetRecommendation", "cost-optimization-hub:ListRecommendations", "cost-optimization-hub:ListRecommendationSummaries", "cost-optimization-hub:ListEfficiencyMetrics"],
      "Resource": "*"
    }
  ]
}
